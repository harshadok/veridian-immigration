# Server
PORT=5050
CORS_ORIGIN=http://localhost:3000

# Admin (for GET /api/enquiry)
ADMIN_KEY=change-me-to-a-strong-secret

# SMTP (Gmail example — use an App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=youremail@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=youremail@gmail.com
NOTIFY_EMAIL=info@veridianimmigration.com

# Google Sheets integration
# - Create a Service Account in Google Cloud
# - Grant it edit access to the spreadsheet
# - Paste the JSON key here as base64
GOOGLE_SPREADSHEET_ID=your_sheet_id_here
GOOGLE_SERVICE_ACCOUNT_KEY_BASE64=your_base64_encoded_json_key_here
